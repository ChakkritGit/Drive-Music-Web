# partyserver's peer dep wants @cloudflare/workers-types@^4.x while wrangler wants ^5.x — both
# are type-only (compile-time) requirements with no runtime effect, so the conflict is safe to
# ignore rather than actually resolve. Needed so `npm install` succeeds on Vercel's clean-room
# build the same way it does locally.
legacy-peer-deps=true
